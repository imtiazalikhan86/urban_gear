NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbangear?schema=public
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=urbangear-api
JWT_AUDIENCE=urbangear-clients
SEED_ADMIN_NAME=Urban Gear Admin
SEED_ADMIN_EMAIL=admin@urbangear.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
