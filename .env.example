NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbangear?schema=public
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=urbangear-api
JWT_AUDIENCE=urbangear-clients
SEED_ADMIN_NAME=Urban Gear Admin
SEED_ADMIN_EMAIL=admin@urbangear.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
MAIL_FROM=Urban Gear <no-reply@urbangear.local>
# Leave SMTP_HOST empty in development: reset emails are written to the log instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
