generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RESELLER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(RESELLER)
  status       UserStatus @default(ACTIVE)
  marginPercent Decimal   @default(0) @db.Decimal(5, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  notifications Notification[]

  @@map("users")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  resellerId    String
  status        OrderStatus @default(PENDING)
  currency      String
  marginPercent Decimal     @db.Decimal(5, 2)
  total         Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  reseller      User        @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  @@index([resellerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  productId         String
  productName       String
  sku               String
  quantity          Int
  costPrice         Decimal  @db.Decimal(12, 2)
  customerUnitPrice Decimal  @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Product {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  slug        String   @unique
  description String
  category    String
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notifications Notification[]

  @@index([category])
  @@index([isAvailable])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  productId String?
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([productId])
  @@map("notifications")
}
